# ---- Database -------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dtwin
# The schema owner. Superuser-equivalent within this database, used ONLY by
# the migration runner (packages/db/src/migrate.ts) and test fixtures that
# must set up more than one tenant. NEVER point a running service at this.
POSTGRES_USER=dtwin
POSTGRES_PASSWORD=dtwin_dev_pwd

# The application role, created by migration 007_tenancy.sql. Every service
# (ingest, web, sim) connects as this — it is subject to every row-level
# security policy, including on tables the owner would silently bypass.
POSTGRES_APP_USER=dtwin_app
POSTGRES_APP_PASSWORD=dtwin_app_dev_pwd

# Assembled forms used by @dtwin/db; each overrides its POSTGRES_* parts above
# when set. GETTING THESE TWO BACKWARDS DOES NOT ERROR — it silently makes
# every application query run as the schema owner, which bypasses row-level
# security unconditionally (FORCE included) and defeats tenant isolation with
# no error anywhere. See docs/decisions.md §41.
#   DATABASE_URL        -> the APP role. Every service reads this.
#   DATABASE_URL_OWNER   -> the OWNER role. Only the migration runner and
#                           multi-tenant test fixtures read this. Falls back to
#                           DATABASE_URL when unset, so an unset value here is
#                           only safe if DATABASE_URL already points at the
#                           owner — which migrate.ts assumes it does not.
DATABASE_URL=postgres://dtwin_app:dtwin_app_dev_pwd@localhost:5432/dtwin
DATABASE_URL_OWNER=postgres://dtwin:dtwin_dev_pwd@localhost:5432/dtwin

# ---- Ingest service -------------------------------------------------------
INGEST_PORT=8787
# Readings are buffered and flushed as a batch; whichever limit trips first.
INGEST_FLUSH_INTERVAL_MS=1000
INGEST_FLUSH_MAX_ROWS=5000

# ---- Alerting -------------------------------------------------------------
# Notification delivery is outward-facing, so it is opt-in: a development
# database seeded with a real webhook must not start calling it on boot.
ALERT_NOTIFY_ENABLED=false
# SMTP for the email alert channel, as a URL:
#   smtp://user:pass@host:587      (STARTTLS)
#   smtps://user:pass@host:465     (implicit TLS)
# Unset, email destinations keep recording `failed` with "no email transport
# configured" — the honest answer to "was anyone told?", and better than a
# channel that looks wired and is not. ALERT_EMAIL_FROM is required with it;
# most relays reject a missing envelope sender.
ALERT_SMTP_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TIMEOUT_MS=10000

ALERT_WEBHOOK_TIMEOUT_MS=5000
ALERT_WEBHOOK_MAX_ATTEMPTS=3
# Webhook URLs come from operator-edited rule config. Destinations resolving to
# private or loopback addresses are blocked so the service cannot be used as a
# proxy onto the internal network. Enable only to test a local receiver.
ALERT_WEBHOOK_ALLOW_PRIVATE=false

# ---- Simulation worker ----------------------------------------------------
SIM_PORT=8000
SIM_BASE_URL=http://localhost:8000
# The worker posts run progress here; ingest owns every WebSocket subscription.
INGEST_BASE_URL=http://localhost:8787
# INGEST_INTERNAL_TOKEN is GONE — the worker now authenticates to
# /internal/sim-event with a `service` API key like any other caller, minted
# per tenant (see docs/multi-tenancy.md and createApiKey in
# packages/db/src/queries/tenancy.ts). There is no environment variable for it
# because a key is tenant-scoped data, not process configuration.

# The worker's own credential for POST /internal/sim-event: a tenant-scoped
# `service` key with the sim:notify scope. `npm run bootstrap` mints it and
# prints it; the key is shown once, at creation, and only its hash is stored.
INGEST_API_KEY=

# The web service's credential for the simulation worker: a tenant-scoped
# `service` key with the sim:run scope, minted by `npm run bootstrap`.
#
# The key says the web service may name a tenant; X-Tenant-Id says which one.
# One key serves every tenant, so the two cannot be the same credential — see
# apps/sim/app/auth.py. Without it the worker answers 401.
SIM_API_KEY=

# Set false only for a worker on a closed network with nothing in front of it.
# On by default, because a default that works everywhere is a default that
# ships.
SIM_REQUIRE_API_KEY=true

# ---- Web ------------------------------------------------------------------
NEXT_PUBLIC_WS_URL=ws://localhost:8787/ws

# ---- Auth -------------------------------------------------------------
# Signs WebSocket tickets (packages/db/src/auth.ts). Required, at least 32
# characters, and MUST be identical between the web and ingest services — a
# mismatch fails every WebSocket auth handshake with "invalid or expired
# ticket". No development default ships here on purpose: a fallback secret
# that works locally is a fallback secret that reaches production.
#   openssl rand -base64 32
AUTH_SECRET=

# ---- Web: demo tenant -----------------------------------------------------
# The dashboard resolves its tenant from the session cookie. This names the
# tenant to render for when no session is present — a development convenience
# only. IGNORED when NODE_ENV=production (apps/web/lib/tenant.ts): a demo
# convenience must not become the way a deployment authenticates.
# `npm run bootstrap` prints it, or:  select id from tenants where slug = 'corniche';
DTWIN_DEMO_TENANT_ID=

# The fallback is OFF unless this is exactly 'true'. It was gated on NODE_ENV
# alone, which worked but rests on a value Next inlines at BUILD time — so the
# running server evaluates what the compiler saw, not what the environment
# holds. That is fragile for a security decision and fails silently in the
# direction that matters, so the fallback is now an explicit runtime opt-in.
DTWIN_ALLOW_DEMO_TENANT=true

# ---- Demo data ------------------------------------------------------------
# `npm run db:migrate` SKIPS 005_seed.sql and records it as `skipped:`, so a
# deployment does not quietly acquire the demonstration building. Set this (or
# use `npm run db:seed`, which sets it for you) to apply the seed instead.
#
# The choice is per-database and one-way: 007 makes tenant_id NOT NULL, so the
# seed only inserts in its own chain position. `npm run db:migrate --status`
# reports which one a database got.
DTWIN_SEED_DEMO=false

# ---- Simulation worker: durability ----------------------------------------
# Runs this process executes at once. Past this, POST /simulate answers 429
# rather than accepting work it has not promised to reach (decisions.md §47).
SIM_MAX_CONCURRENT_RUNS=2
# Fail runs a previous process left at queued/running, at startup. Set false
# only when several workers share one database, where another process's live
# run is not this one's orphan.
SIM_REAP_ORPHANS=true
